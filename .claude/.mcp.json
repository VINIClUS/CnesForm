{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from git+https://github.com/oraios/serena@main serena start-mcp-server"
      ]
    },
    "ref": {
      "type": "http",
      "url": "https://api.ref.tools/mcp?apiKey=r5u16yf3r5u16yf3r5u16yf3r5u16yf3r5u16yf3r5u16yf3"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "deepwiki": {
      "serverUrl": "https://mcp.deepwiki.com/mcp"
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}